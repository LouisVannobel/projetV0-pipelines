{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**",
    "**/fixtures/**"
  ],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "schedule": ["after 07:00 and before 10:00 on monday"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)[\\t ]+driver-opts:[\\t ]+image=moby/buildkit:(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:[\\t ]*(?:\\r?\\n|$))"
      ],
      "depNameTemplate": "moby/buildkit",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "No dependency update bypasses human review during the experimental phase",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose", "npm", "custom.regex"],
      "automerge": false
    },
    {
      "description": "Keep breaking updates isolated",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "Group non-breaking GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions"
    }
  ]
}
