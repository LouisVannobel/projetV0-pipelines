{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "schedule": ["after 07:00 and before 10:00 on monday"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "No dependency update bypasses human review during the experimental phase",
      "matchManagers": ["github-actions", "dockerfile", "docker-compose", "npm", "custom.regex"],
      "automerge": false
    },
    {
      "description": "Keep breaking updates isolated",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking-change"]
    },
    {
      "description": "Group non-breaking CI tool updates",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions"
    }
  ],
  "customManagers": [
    {
      "description": "Track checksum-pinned CLI releases embedded in workflows",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+[a-z0-9_]+_version=(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "description": "Track the reusable SaaS pnpm default",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/reusable-saas-ci\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+default:\\s+[\\\"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\\\"]?"
      ]
    }
  ]
}
